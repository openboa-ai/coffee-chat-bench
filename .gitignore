# Raw provisional Judge evidence is immutable Release-asset content. Keep
# compact manifests, metrics, gates, and indexes in Git; archive the repeated
# prompts, labels, responses, attempts, routing plans, and plots externally.
/qualification/hill-climbing/steps/*/evaluations.jsonl
/qualification/hill-climbing/steps/*/prompt.json
/qualification/hill-climbing/steps/*/reference-labels.json
/qualification/hill-climbing/steps/*/routing-plan.json
/qualification/hill-climbing/steps/*/run.png
