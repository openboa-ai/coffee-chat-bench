{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openboa.ai/coffee-chat-bench/2026.8.12/schemas/verdict.schema.json",
  "title": "PCDA trial or family verdict",
  "$comment": "Structural wire and state-coherence validation. Runtime qualification functions remain authoritative for conjunctive decision, evidence, and family semantics.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "release": { "const": "2026.8.12" },
    "trialId": { "$ref": "#/$defs/trialId" },
    "caseId": { "$ref": "#/$defs/nonEmptyString" },
    "familyId": { "$ref": "#/$defs/nonEmptyString" },
    "domain": { "$ref": "#/$defs/nonEmptyString" },
    "operation": { "$ref": "#/$defs/nonEmptyString" },
    "condition": { "$ref": "#/$defs/condition" },
    "conditionLabels": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/condition" }
    },
    "state": { "$ref": "#/$defs/resultState" },
    "qualified": { "type": ["boolean", "null"] },
    "dimensions": {
      "anyOf": [{ "$ref": "#/$defs/dimensions" }, { "type": "null" }]
    },
    "criticalFailure": { "type": ["boolean", "null"] },
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/trialDecision" }
    },
    "evidenceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "efficiency": {
      "anyOf": [
        { "$ref": "#/$defs/efficiencySample" },
        { "type": "array", "items": { "$ref": "#/$defs/efficiencySample" } },
        { "type": "null" }
      ]
    },
    "sensitiveContrast": { "type": ["boolean", "null"] },
    "invariantsPreserved": { "type": ["boolean", "null"] },
    "trialStateCounts": { "$ref": "#/$defs/stateCounts" }
  },
  "oneOf": [
    {
      "required": [
        "release",
        "trialId",
        "caseId",
        "familyId",
        "domain",
        "operation",
        "condition",
        "state",
        "qualified",
        "dimensions",
        "criticalFailure",
        "decisions",
        "evidenceRefs",
        "efficiency"
      ],
      "properties": {
        "efficiency": {
          "anyOf": [{ "$ref": "#/$defs/efficiencySample" }, { "type": "null" }]
        }
      },
      "not": {
        "anyOf": [
          { "required": ["conditionLabels"] },
          { "required": ["sensitiveContrast"] },
          { "required": ["invariantsPreserved"] },
          { "required": ["trialStateCounts"] }
        ]
      },
      "allOf": [
        {
          "if": {
            "required": ["state"],
            "properties": { "state": { "const": "measured" } }
          },
          "then": {
            "properties": {
              "qualified": { "type": "boolean" },
              "dimensions": { "$ref": "#/$defs/dimensions" },
              "criticalFailure": { "type": "boolean" },
              "decisions": { "type": "array", "minItems": 1 }
            }
          },
          "else": {
            "properties": {
              "state": { "$ref": "#/$defs/nonMeasuredState" },
              "qualified": { "type": "null" },
              "dimensions": { "type": "null" },
              "criticalFailure": { "type": "null" },
              "decisions": { "type": "array", "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "required": ["criticalFailure"],
            "properties": { "criticalFailure": { "const": true } }
          },
          "then": {
            "properties": {
              "qualified": { "const": false },
              "dimensions": {
                "type": "object",
                "required": ["criticalFailure"],
                "properties": { "criticalFailure": { "const": true } }
              }
            }
          }
        },
        {
          "if": {
            "required": ["dimensions"],
            "properties": {
              "dimensions": {
                "type": "object",
                "required": ["criticalFailure"],
                "properties": { "criticalFailure": { "const": true } }
              }
            }
          },
          "then": {
            "properties": {
              "qualified": { "const": false },
              "criticalFailure": { "const": true }
            }
          }
        },
        {
          "if": {
            "required": ["qualified"],
            "properties": { "qualified": { "const": true } }
          },
          "then": {
            "properties": {
              "criticalFailure": { "const": false },
              "dimensions": { "$ref": "#/$defs/passingDimensions" },
              "decisions": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/passingTrialDecision" }
              }
            }
          }
        }
      ]
    },
    {
      "required": [
        "release",
        "familyId",
        "domain",
        "operation",
        "state",
        "qualified",
        "conditionLabels",
        "sensitiveContrast",
        "invariantsPreserved",
        "criticalFailure",
        "trialStateCounts",
        "efficiency"
      ],
      "properties": {
        "efficiency": {
          "type": "array",
          "items": { "$ref": "#/$defs/efficiencySample" }
        }
      },
      "not": {
        "anyOf": [
          { "required": ["trialId"] },
          { "required": ["caseId"] },
          { "required": ["condition"] },
          { "required": ["dimensions"] },
          { "required": ["decisions"] },
          { "required": ["evidenceRefs"] }
        ]
      },
      "allOf": [
        {
          "if": {
            "required": ["state"],
            "properties": { "state": { "const": "measured" } }
          },
          "then": {
            "properties": {
              "qualified": { "type": "boolean" },
              "conditionLabels": {
                "type": "array",
                "minItems": 2,
                "contains": { "const": "T1-A" },
                "allOf": [{ "contains": { "const": "T1-B" } }]
              },
              "sensitiveContrast": { "type": "boolean" },
              "invariantsPreserved": { "type": "boolean" },
              "criticalFailure": { "type": "boolean" }
            }
          },
          "else": {
            "properties": {
              "state": { "$ref": "#/$defs/nonMeasuredState" },
              "qualified": { "type": "null" },
              "sensitiveContrast": { "type": "null" },
              "invariantsPreserved": { "type": "null" },
              "criticalFailure": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "required": ["qualified"],
            "properties": { "qualified": { "const": true } }
          },
          "then": {
            "properties": {
              "sensitiveContrast": { "const": true },
              "invariantsPreserved": { "const": true },
              "criticalFailure": { "const": false }
            }
          }
        },
        {
          "if": {
            "required": ["criticalFailure"],
            "properties": { "criticalFailure": { "const": true } }
          },
          "then": { "properties": { "qualified": { "const": false } } }
        }
      ]
    }
  ],
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "trialId": {
      "type": "string",
      "pattern": "^trial-[0-9a-f]{64}$"
    },
    "condition": { "enum": ["T0", "T1-A", "T1-B"] },
    "resultState": {
      "enum": [
        "measured",
        "candidate_invalid",
        "candidate_failure",
        "host_failure",
        "verifier_failure",
        "judge_disagreement",
        "judge_unavailable",
        "skipped",
        "unavailable",
        "unmeasured"
      ]
    },
    "nonMeasuredState": {
      "enum": [
        "candidate_invalid",
        "candidate_failure",
        "host_failure",
        "verifier_failure",
        "judge_disagreement",
        "judge_unavailable",
        "skipped",
        "unavailable",
        "unmeasured"
      ]
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskAdequate",
        "evidenceIntegrity",
        "perspectiveAligned",
        "invariantsPreserved",
        "criticalFailure"
      ],
      "properties": {
        "taskAdequate": { "type": "boolean" },
        "evidenceIntegrity": { "type": "boolean" },
        "perspectiveAligned": { "type": "boolean" },
        "invariantsPreserved": { "type": "boolean" },
        "criticalFailure": { "type": "boolean" }
      }
    },
    "passingDimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskAdequate",
        "evidenceIntegrity",
        "perspectiveAligned",
        "invariantsPreserved",
        "criticalFailure"
      ],
      "properties": {
        "taskAdequate": { "const": true },
        "evidenceIntegrity": { "const": true },
        "perspectiveAligned": { "const": true },
        "invariantsPreserved": { "const": true },
        "criticalFailure": { "const": false }
      }
    },
    "trialDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionId",
        "selectedRegion",
        "evidenceRefs",
        "partition",
        "accepted",
        "evidenceComplete"
      ],
      "properties": {
        "decisionId": { "$ref": "#/$defs/nonEmptyString" },
        "selectedRegion": { "$ref": "#/$defs/nonEmptyString" },
        "evidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "partition": { "enum": ["sensitive", "invariant"] },
        "accepted": { "type": "boolean" },
        "evidenceComplete": { "type": "boolean" }
      }
    },
    "passingTrialDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionId",
        "selectedRegion",
        "evidenceRefs",
        "partition",
        "accepted",
        "evidenceComplete"
      ],
      "properties": {
        "decisionId": { "$ref": "#/$defs/nonEmptyString" },
        "selectedRegion": { "$ref": "#/$defs/nonEmptyString" },
        "evidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "partition": { "enum": ["sensitive", "invariant"] },
        "accepted": { "const": true },
        "evidenceComplete": { "const": true }
      }
    },
    "efficiencySample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wallTimeMs", "inputTokens", "outputTokens"],
      "properties": {
        "wallTimeMs": { "type": "number", "minimum": 0 },
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 }
      }
    },
    "stateCounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "measured": { "type": "integer", "minimum": 0 },
        "candidate_invalid": { "type": "integer", "minimum": 0 },
        "candidate_failure": { "type": "integer", "minimum": 0 },
        "host_failure": { "type": "integer", "minimum": 0 },
        "verifier_failure": { "type": "integer", "minimum": 0 },
        "judge_disagreement": { "type": "integer", "minimum": 0 },
        "judge_unavailable": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "unavailable": { "type": "integer", "minimum": 0 },
        "unmeasured": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
