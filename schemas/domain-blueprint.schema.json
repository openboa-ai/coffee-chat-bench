{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openboa.ai/coffee-chat-bench/2026.8.12/schemas/domain-blueprint.schema.json",
  "title": "PCDA semantic domain blueprint",
  "$comment": "Semantic author input only. Digests and admission outcomes are deliberately absent and are computed by materializeCampaign.",
  "type": "object",
  "additionalProperties": false,
  "required": ["release", "domain", "drafts"],
  "properties": {
    "release": { "const": "2026.8.12" },
    "domain": { "enum": ["product", "research", "operations"] },
    "drafts": {
      "type": "array",
      "minItems": 48,
      "maxItems": 48,
      "items": { "$ref": "#/$defs/draft" },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["intent"],
            "properties": { "intent": { "const": "admitted" } }
          },
          "minContains": 32,
          "maxContains": 32
        },
        {
          "contains": {
            "type": "object",
            "required": ["intent"],
            "properties": { "intent": { "const": "rejected" } }
          },
          "minContains": 16,
          "maxContains": 16
        }
      ]
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "stringSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "pairId": {
      "enum": [
        "speed/assurance",
        "exploration/convergence",
        "local/systems",
        "novelty/precedent",
        "agency/guidance",
        "breadth/depth",
        "reversible/committed",
        "explicit-process/adaptive-judgment"
      ]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instruction", "deliverable"],
      "properties": {
        "instruction": { "$ref": "#/$defs/nonEmptyString" },
        "deliverable": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "evidenceRef": {
      "type": "string",
      "pattern": "^(?!(?:__proto__|constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "evidenceMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/evidenceRef" },
      "additionalProperties": { "$ref": "#/$defs/nonEmptyString" }
    },
    "acceptedRegions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["T0", "T1-A", "T1-B"],
      "properties": {
        "T0": { "$ref": "#/$defs/stringSet" },
        "T1-A": { "$ref": "#/$defs/stringSet" },
        "T1-B": { "$ref": "#/$defs/stringSet" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionId",
        "prompt",
        "regionOptions",
        "partition",
        "acceptedRegions",
        "requiredEvidenceRefs"
      ],
      "properties": {
        "decisionId": { "$ref": "#/$defs/nonEmptyString" },
        "prompt": { "$ref": "#/$defs/nonEmptyString" },
        "regionOptions": { "$ref": "#/$defs/stringSet" },
        "partition": { "enum": ["sensitive", "invariant"] },
        "acceptedRegions": { "$ref": "#/$defs/acceptedRegions" },
        "requiredEvidenceRefs": { "$ref": "#/$defs/stringSet" }
      }
    },
    "modelId": {
      "enum": ["gpt-5.6-sol", "gpt-5.6-terra", "gpt-5.6-luna"]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorModelId",
        "criticModelId",
        "adversaryModelId",
        "decisiveModelId"
      ],
      "properties": {
        "authorModelId": { "$ref": "#/$defs/modelId" },
        "criticModelId": { "$ref": "#/$defs/modelId" },
        "adversaryModelId": { "$ref": "#/$defs/modelId" },
        "decisiveModelId": { "$ref": "#/$defs/modelId" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "reason"],
      "properties": {
        "passed": { "type": "boolean" },
        "reason": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskOnlyUnderdetermination",
        "perspectiveOnlyInsufficiency",
        "counterfactualShift",
        "locality",
        "irrelevantStability",
        "paraphraseInvariance",
        "antiEcho",
        "rights",
        "deterministicOraclePass",
        "deterministicNoOpFailure",
        "deterministicListAllFailure"
      ],
      "properties": {
        "taskOnlyUnderdetermination": { "$ref": "#/$defs/check" },
        "perspectiveOnlyInsufficiency": { "$ref": "#/$defs/check" },
        "counterfactualShift": { "$ref": "#/$defs/check" },
        "locality": { "$ref": "#/$defs/check" },
        "irrelevantStability": { "$ref": "#/$defs/check" },
        "paraphraseInvariance": { "$ref": "#/$defs/check" },
        "antiEcho": { "$ref": "#/$defs/check" },
        "rights": { "$ref": "#/$defs/check" },
        "deterministicOraclePass": { "$ref": "#/$defs/check" },
        "deterministicNoOpFailure": { "$ref": "#/$defs/check" },
        "deterministicListAllFailure": { "$ref": "#/$defs/check" }
      }
    },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draftId",
        "intent",
        "partition",
        "caseId",
        "familyId",
        "operation",
        "difficulty",
        "task",
        "evidence",
        "perspectivePairId",
        "decisions",
        "nonGoal",
        "provenance",
        "checks"
      ],
      "properties": {
        "draftId": { "$ref": "#/$defs/nonEmptyString" },
        "intent": { "enum": ["admitted", "rejected"] },
        "partition": {
          "enum": ["development", "calibration", "release", "bridge"]
        },
        "caseId": { "$ref": "#/$defs/nonEmptyString" },
        "familyId": { "$ref": "#/$defs/nonEmptyString" },
        "operation": { "$ref": "#/$defs/nonEmptyString" },
        "difficulty": { "$ref": "#/$defs/nonEmptyString" },
        "task": { "$ref": "#/$defs/task" },
        "evidence": { "$ref": "#/$defs/evidenceMap" },
        "perspectivePairId": { "$ref": "#/$defs/pairId" },
        "decisions": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/decision" },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": ["partition"],
                "properties": { "partition": { "const": "sensitive" } }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": ["partition"],
                "properties": { "partition": { "const": "invariant" } }
              }
            }
          ]
        },
        "nonGoal": { "$ref": "#/$defs/nonEmptyString" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "checks": { "$ref": "#/$defs/checks" }
      }
    }
  }
}
