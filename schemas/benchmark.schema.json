{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openboa-ai/coffee-chat-bench/schema/2026-08-19",
  "title": "Public multi-document judgment-history case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release",
    "caseId",
    "pairId",
    "form",
    "domain",
    "transferType",
    "taskArchetype",
    "taskMode",
    "task",
    "documents",
    "contexts",
    "lineage",
    "manifestDigest"
  ],
  "properties": {
    "release": { "const": "2026.8.19" },
    "caseId": { "$ref": "#/$defs/text" },
    "pairId": { "$ref": "#/$defs/text" },
    "form": { "enum": ["dialogue", "professional_artifact"] },
    "domain": { "$ref": "#/$defs/text" },
    "transferType": {
      "enum": [
        "near_transfer",
        "far_transfer",
        "boundary_condition",
        "cue_conflict"
      ]
    },
    "taskArchetype": {
      "enum": [
        "recommendation",
        "allocation_prioritization",
        "design_threshold",
        "critique_revision"
      ]
    },
    "taskMode": { "enum": ["bounded", "open_ended"] },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instruction",
        "environment",
        "deliverables",
        "hardConstraints",
        "output"
      ],
      "properties": {
        "instruction": { "$ref": "#/$defs/text" },
        "environment": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": { "kind": { "const": "conversation" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "fixtureDigest", "verifierDigest"],
              "properties": {
                "kind": { "const": "workspace" },
                "fixtureDigest": { "$ref": "#/$defs/digest" },
                "verifierDigest": { "$ref": "#/$defs/digest" }
              }
            }
          ]
        },
        "deliverables": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/text" },
          "uniqueItems": true
        },
        "hardConstraints": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/text" },
          "uniqueItems": true
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mediaType", "maxBytes", "requiredReferenceIds"],
          "properties": {
            "mediaType": { "const": "text/plain" },
            "maxBytes": { "type": "integer", "minimum": 1 },
            "requiredReferenceIds": {
              "type": "array",
              "items": { "$ref": "#/$defs/text" },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 4,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/document" }
    },
    "contexts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unconditioned", "target_a", "target_b"],
      "properties": {
        "unconditioned": { "type": "array", "maxItems": 0 },
        "target_a": { "$ref": "#/$defs/history" },
        "target_b": { "$ref": "#/$defs/history" }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceIds", "scenarioId"],
      "properties": {
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/text" },
          "uniqueItems": true
        },
        "scenarioId": { "$ref": "#/$defs/text" }
      }
    },
    "manifestDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "documentType",
        "title",
        "authorRole",
        "recordedAt",
        "content",
        "source",
        "license"
      ],
      "properties": {
        "documentId": { "$ref": "#/$defs/text" },
        "documentType": { "$ref": "#/$defs/text" },
        "title": { "$ref": "#/$defs/text" },
        "authorRole": { "$ref": "#/$defs/text" },
        "recordedAt": { "type": ["string", "null"] },
        "content": { "$ref": "#/$defs/text" },
        "source": { "$ref": "#/$defs/text" },
        "license": { "const": "MIT" }
      }
    },
    "history": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "format", "content"],
        "properties": {
          "id": { "$ref": "#/$defs/text" },
          "format": {
            "enum": [
              "decision_note",
              "message_excerpt",
              "retrospective",
              "structured_log"
            ]
          },
          "content": { "$ref": "#/$defs/text" }
        }
      }
    }
  }
}
