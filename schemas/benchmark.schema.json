{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openboa-ai/coffee-chat-bench/schema/2026-08-17",
  "title": "Public judgment-history case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release",
    "caseId",
    "pairId",
    "form",
    "domain",
    "transferType",
    "taskArchetype",
    "taskMode",
    "split",
    "task",
    "evidence",
    "contexts",
    "lineage",
    "manifestDigest"
  ],
  "properties": {
    "release": { "const": "2026.8.17" },
    "caseId": { "$ref": "#/$defs/text" },
    "pairId": { "$ref": "#/$defs/text" },
    "form": { "enum": ["dialogue", "professional_artifact"] },
    "domain": { "$ref": "#/$defs/text" },
    "transferType": {
      "enum": ["near_transfer", "far_transfer", "boundary", "policy_conflict"]
    },
    "taskArchetype": {
      "enum": [
        "recommendation",
        "allocation_prioritization",
        "design_threshold",
        "critique_revision"
      ]
    },
    "taskMode": { "enum": ["bounded", "open_ended"] },
    "split": { "const": "public" },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instruction", "environment", "output"],
      "properties": {
        "instruction": { "$ref": "#/$defs/text" },
        "environment": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": { "kind": { "const": "conversation" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "fixtureDigest", "verifierDigest"],
              "properties": {
                "kind": { "const": "workspace" },
                "fixtureDigest": { "$ref": "#/$defs/digest" },
                "verifierDigest": { "$ref": "#/$defs/digest" }
              }
            }
          ]
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mediaType", "maxBytes", "requiredReferenceIds"],
          "properties": {
            "mediaType": { "const": "text/plain" },
            "maxBytes": { "type": "integer", "minimum": 1 },
            "requiredReferenceIds": {
              "type": "array",
              "items": { "$ref": "#/$defs/text" },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "content", "source", "license"],
        "properties": {
          "id": { "$ref": "#/$defs/text" },
          "content": { "$ref": "#/$defs/text" },
          "source": { "$ref": "#/$defs/text" },
          "license": { "const": "MIT" }
        }
      }
    },
    "contexts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unconditioned", "target_a", "target_b"],
      "properties": {
        "unconditioned": { "type": "array", "maxItems": 0 },
        "target_a": { "$ref": "#/$defs/history" },
        "target_b": { "$ref": "#/$defs/history" }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceIds", "templateId"],
      "properties": {
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/text" },
          "uniqueItems": true
        },
        "templateId": { "$ref": "#/$defs/text" }
      }
    },
    "manifestDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "history": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "format", "content"],
        "properties": {
          "id": { "$ref": "#/$defs/text" },
          "format": {
            "enum": [
              "decision_note",
              "message_excerpt",
              "retrospective",
              "structured_log"
            ]
          },
          "content": { "$ref": "#/$defs/text" }
        }
      }
    }
  }
}
