{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openboa.ai/coffee-chat-bench/2026.8.12/schemas/case.schema.json",
  "title": "PCDA case bundle",
  "$comment": "Structural wire validation only. Use the exported runtime parser parseCaseBundle for authoritative semantic validation of IDs, references, accepted-region subsets, content digests, pair provenance, and the semantic source digest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release",
    "caseId",
    "familyId",
    "domain",
    "operation",
    "difficulty",
    "task",
    "sourceDigest",
    "evidence",
    "perspectives",
    "decisions",
    "nonGoal"
  ],
  "properties": {
    "release": { "const": "2026.8.12" },
    "caseId": { "$ref": "#/$defs/nonEmptyString" },
    "familyId": { "$ref": "#/$defs/nonEmptyString" },
    "domain": { "$ref": "#/$defs/nonEmptyString" },
    "operation": { "$ref": "#/$defs/nonEmptyString" },
    "difficulty": { "$ref": "#/$defs/nonEmptyString" },
    "task": { "$ref": "#/$defs/task" },
    "sourceDigest": { "$ref": "#/$defs/digest" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidenceReference" }
    },
    "perspectives": { "$ref": "#/$defs/perspectives" },
    "decisions": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/decision" },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["partition"],
            "properties": { "partition": { "const": "sensitive" } }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": ["partition"],
            "properties": { "partition": { "const": "invariant" } }
          }
        }
      ]
    },
    "nonGoal": { "$ref": "#/$defs/nonEmptyString" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stringSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instruction", "deliverable"],
      "properties": {
        "instruction": { "$ref": "#/$defs/nonEmptyString" },
        "deliverable": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "content", "digest"],
      "properties": {
        "ref": { "$ref": "#/$defs/nonEmptyString" },
        "content": { "$ref": "#/$defs/nonEmptyString" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "perspective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pairId", "content", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "pairId": { "$ref": "#/$defs/nonEmptyString" },
        "content": { "$ref": "#/$defs/nonEmptyString" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "perspectives": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B", "irrelevant"],
      "properties": {
        "A": { "$ref": "#/$defs/perspective" },
        "B": { "$ref": "#/$defs/perspective" },
        "irrelevant": { "$ref": "#/$defs/perspective" }
      }
    },
    "acceptedRegions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["T0", "T1-A", "T1-B"],
      "properties": {
        "T0": { "$ref": "#/$defs/stringSet" },
        "T1-A": { "$ref": "#/$defs/stringSet" },
        "T1-B": { "$ref": "#/$defs/stringSet" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionId",
        "prompt",
        "regionOptions",
        "partition",
        "acceptedRegions",
        "requiredEvidenceRefs"
      ],
      "properties": {
        "decisionId": { "$ref": "#/$defs/nonEmptyString" },
        "prompt": { "$ref": "#/$defs/nonEmptyString" },
        "regionOptions": { "$ref": "#/$defs/stringSet" },
        "partition": { "enum": ["sensitive", "invariant"] },
        "acceptedRegions": { "$ref": "#/$defs/acceptedRegions" },
        "requiredEvidenceRefs": { "$ref": "#/$defs/stringSet" }
      }
    }
  }
}
