{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openboa.ai/coffee-chat-bench/2026.8.12/schemas/judge-campaign.schema.json",
  "title": "Experimental PCDA judge campaign configuration",
  "$comment": "Structural configuration only; it is not an activation record or measured benchmark result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "role",
    "calver",
    "models",
    "requestsPerModel",
    "responseFormat",
    "malformedRetries",
    "campaignCapNanoUsd",
    "tariffSnapshot"
  ],
  "properties": {
    "role": { "const": "experimental_judge_configuration" },
    "calver": { "const": "2026.8.12" },
    "models": {
      "type": "array",
      "const": ["gpt-5.6-terra", "gpt-5.6-luna"]
    },
    "requestsPerModel": { "const": 1 },
    "responseFormat": { "const": "judge-v1" },
    "malformedRetries": { "const": 1 },
    "campaignCapNanoUsd": { "const": 50000000000 },
    "tariffSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fetchedAt", "sourceUrl", "currency", "unit", "models"],
      "properties": {
        "fetchedAt": { "const": "2026-08-12" },
        "sourceUrl": { "type": "string", "pattern": "^https://openai\\.com/" },
        "currency": { "const": "USD" },
        "unit": { "const": "per_1m_tokens" },
        "models": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gpt-5.6-terra", "gpt-5.6-luna"],
          "properties": {
            "gpt-5.6-terra": { "$ref": "#/$defs/terraTariff" },
            "gpt-5.6-luna": { "$ref": "#/$defs/lunaTariff" }
          }
        }
      }
    }
  },
  "$defs": {
    "terraTariff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputUsd", "outputUsd"],
      "properties": { "inputUsd": { "const": 2 }, "outputUsd": { "const": 12 } }
    },
    "lunaTariff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputUsd", "outputUsd"],
      "properties": {
        "inputUsd": { "const": 0.2 },
        "outputUsd": { "const": 1.2 }
      }
    }
  }
}
