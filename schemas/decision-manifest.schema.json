{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openboa.ai/coffee-chat-bench/2026.8.12/schemas/decision-manifest.schema.json",
  "title": "PCDA decision manifest",
  "$comment": "Structural wire validation only. Use the exported runtime parser parseDecisionManifest for authoritative semantic validation of decision-ID uniqueness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release",
    "trialId",
    "caseId",
    "condition",
    "artifactDigest",
    "decisions"
  ],
  "properties": {
    "release": { "const": "2026.8.12" },
    "trialId": {
      "type": "string",
      "pattern": "^trial-[0-9a-f]{64}$"
    },
    "caseId": { "type": "string", "minLength": 1 },
    "condition": { "enum": ["T0", "T1-A", "T1-B"] },
    "artifactDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decisionId", "selectedRegion", "evidenceRefs"],
        "properties": {
          "decisionId": { "type": "string", "minLength": 1 },
          "selectedRegion": { "type": "string", "minLength": 1 },
          "evidenceRefs": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
